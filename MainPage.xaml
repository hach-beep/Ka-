<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cafeteria.MainPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#D5DCF9">

    <!-- Main Layout: 3 Columns (Navigation, Menu, Invoice) -->
    <Grid ColumnDefinitions="80, *, 380">

        <!-- 1. NAVIGATION SIDEBAR (Muted Blue) -->
        <Border Grid.Column="0" BackgroundColor="#A7B0CA" StrokeThickness="0">
            <VerticalStackLayout Padding="10" Spacing="25" VerticalOptions="Center">
                <Label Text="🏠" FontSize="30" HorizontalOptions="Center"/>
                <Label Text="🍔" FontSize="30" HorizontalOptions="Center"/>
                <Label Text="📊" FontSize="30" HorizontalOptions="Center"/>
                <Label Text="⚙️" FontSize="30" HorizontalOptions="Center" Margin="0,50,0,0"/>
            </VerticalStackLayout>
        </Border>

        <!-- 2. CENTER AREA: MENU GRID -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *" Padding="20">
            <!-- Search & Header -->
            <HorizontalStackLayout Grid.Row="0" Spacing="20" Margin="0,0,0,20">
                <Label Text="قائمة الأصناف" FontSize="26" FontAttributes="Bold" TextColor="#725E54" VerticalOptions="Center"/>
                <Border Stroke="#A7B0CA" StrokeThickness="1" WidthRequest="300" HeightRequest="45" BackgroundColor="White">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                    <Entry Placeholder="بحث عن مادة..." Margin="15,0" VerticalOptions="Center"/>
                </Border>
            </HorizontalStackLayout>

            <!-- Product Grid (Scrollable) -->
            <ScrollView Grid.Row="1">
                <FlexLayout Wrap="Wrap" JustifyContent="Start">
                    <!-- Example Product Card (Developer can repeat this in his CollectionView) -->
                    <Border WidthRequest="160" HeightRequest="200" Margin="10" BackgroundColor="White" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="15"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/></Border.Shadow>
                        <VerticalStackLayout Padding="10" Spacing="5" HorizontalOptions="Center">
                            <Label Text="🍕" FontSize="50" HorizontalOptions="Center"/>
                            <Label Text="بيتزا" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#725E54"/>
                            <Label Text="45.00" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#E58116"/>
                            <Button Text="إضافة" BackgroundColor="#A7B0CA" HeightRequest="35" CornerRadius="10" FontSize="12"/>
                        </VerticalStackLayout>
                    </Border>
                </FlexLayout>
            </ScrollView>
        </Grid>

        <!-- 3. RIGHT SIDEBAR: INVOICE / ORDER SUMMARY -->
        <Border Grid.Column="2" BackgroundColor="White" Margin="15" StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="25"/></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="Black" Offset="0,5" Opacity="0.1" Radius="10"/></Border.Shadow>

            <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20">
                <Label Grid.Row="0" Text="تفاصيل الفاتورة" FontSize="22" FontAttributes="Bold" TextColor="#725E54" Margin="0,0,0,20"/>
                
                <!-- Customer Inputs -->
                <VerticalStackLayout Grid.Row="1" Spacing="12" Margin="0,0,0,20">
                    <Label Text="بيانات العميل:" TextColor="#A7B0CA" FontSize="14"/>
                    <Border Stroke="#D5DCF9" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Entry Placeholder="رقم الهاتف" Keyboard="Numeric"/>
                    </Border>
                    <Border Stroke="#D5DCF9" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Entry Placeholder="اسم الزبون"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Order List -->
                <CollectionView Grid.Row="2">
                    <!-- Developer will bind his items here -->
                </CollectionView>

                <!-- Totals & Main Action -->
                <VerticalStackLayout Grid.Row="3" Spacing="15" Margin="0,10,0,0">
                    <BoxView HeightRequest="1" Color="#D5DCF9"/>
                    <HorizontalStackLayout HorizontalOptions="SpaceBetween">
                        <Label Text="المجموع:" FontSize="20" FontAttributes="Bold" TextColor="#725E54"/>
                        <Label Text="0.00 د.ع" FontSize="20" FontAttributes="Bold" TextColor="#E58116"/>
                    </HorizontalStackLayout>
                    
                    <!-- THE IMPORTANT BUTTON -->
                    <Button Text="إرسال الطلب للمطبخ" 
                            BackgroundColor="#E58116" 
                            TextColor="White" 
                            HeightRequest="60" 
                            FontSize="18" 
                            FontAttributes="Bold" 
                            CornerRadius="15">
                        <Button.Shadow><Shadow Brush="#E58116" Opacity="0.3" Offset="0,4"/></Button.Shadow>
                    </Button>

                    <Button Text="حذف الكل" BackgroundColor="Transparent" TextColor="Red" FontSize="14"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
